# Your settings: NAS name, share paths and icon paths. Never commit them.
# The example to copy is config.example.json.
config.local.json
.env

# Builds live in ..\Builds\, outside the repo. Safety net in case one lands here.
# (*.lnk: Build.cmd and the release .cmd make shortcuts, which hold full paths on this PC.)
Builds/
*.exe
*.lnk

# Logs (the app writes its own to %APPDATA%\Media Share Mapper\Logs; these catch
# older versions' logs beside the script and Build.log)
*.log

# Registry exports can hold your local icon paths
*.reg

# Temp files and editor backups
*.tmp
*.bak*

# Windows clutter
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor
.vscode/
*.swp
